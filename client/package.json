{
  "name": "voltrus-client",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && rm -f dist/**/*.map dist/*.map && rm -rf ../static && mkdir -p ../static/locales && cp -r dist/* ../static/ && cp -r public/locales/* ../static/locales/",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.0",
    "@tanstack/react-query": "5.100.1",
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/react-virtual": "^3.13.24",
    "dompurify": "3.4.1",
    "i18next": "^25.0.0",
    "i18next-http-backend": "^2.7.3",
    "lightweight-charts": "^5.2.0",
    "marked": "18.0.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-grid-layout": "2.2.3",
    "react-i18next": "^15.0.0",
    "react-rnd": "10.5.3",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
