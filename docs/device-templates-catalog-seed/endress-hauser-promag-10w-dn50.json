    },
    {
      "name": "Flow_Velocity",
      "offset": 2,
      "register_type": "float32",
      "register_area": "holding",
      "scale": 1.0,
      "unit": "m/s",
      "description": "Flow velocity in pipe"
    },
    {
      "name": "Conductivity",
      "offset": 8,
      "register_type": "float32",
      "register_area": "holding",
      "scale": 1.0,
      "unit": "µS/cm",
      "description": "Fluid conductivity"
    },
    {
      "name": "Temperature",
      "offset": 10,
      "register_type": "float32",
      "register_area": "holding",
      "scale": 1.0,
      "unit": "°C",
      "description": "Process fluid temperature"
    },
    {
      "name": "Pipe_Volume",
      "offset": 12,
      "register_type": "float32",
      "register_area": "holding",
      "scale": 1.0,
      "unit": "%",
