{
  "format": "voltrus-device-template/1",
  "template_id": "schneider-electric-pm5560",
  "manufacturer": "Schneider Electric",
  "model": "PM5560",
  "protocol": "modbus",
  "description": "PM5560 3-Phase Power Quality Meter (0.2S, CT/VT)",
  "version": "1.0.0",
  "verified": false,
  "verified_notes": "Derived from the Voltrus simulator profile; not checked against a physical device.",
  "quirks": [
    "Float32 values, 2 registers each, high word first (big endianness); holding registers from offset 0.",
    "64-bit counters, 4 registers each, most significant word first. Values above 2^53 (9.0e15) lose precision.",
    "Only the four energy registers (offsets 3203, 3207, 3219, 3223: INT64 Wh/VARh, read as kWh/kvarh) follow Schneider's register list (PM556x_PublicModbusRegisterList_10th_August-23.xlsx, FAQ FA234017; its register numbers are 1-based, offset = register - 1). The float32 registers from offset 0 are the simulator's layout, not the meter's: on a real PM5560 remap them from that list (e.g. Current A is register 3000, Voltage A-N 3028)."
  ],
  "license": "CC-BY-4.0",
  "port": 502,
  "interval_ms": 1000,
  "unit_id": 1,
  "endianness": "big",
  "registers": [
    {
      "name": "Voltage_L1N",
      "offset": 0,
      "register_type": "float32",
      "register_area": "holding",
      "scale": 1.0,
      "unit": "V",
      "description": "L1-N voltage"
    },
    {
      "name": "Voltage_L2N",
      "offset": 2,
      "register_type": "float32",
      "register_area": "holding",
      "scale": 1.0,
      "unit": "V",
      "description": "L2-N voltage"
    },
    {
      "name": "Voltage_L3N",
      "offset": 4,
      "register_type": "float32",
      "register_area": "holding",
      "scale": 1.0,
      "unit": "V",
      "description": "L3-N voltage"
    },
    {
      "name": "Current_L1",
      "offset": 6,
      "register_type": "float32",
      "register_area": "holding",
      "scale": 1.0,
      "unit": "A",
      "description": "L1 current (via CT)"
    },
    {
      "name": "Current_L2",
      "offset": 8,
      "register_type": "float32",
      "register_area": "holding",
      "scale": 1.0,
      "unit": "A",
      "description": "L2 current (via CT)"
    },
    {
      "name": "Current_L3",
      "offset": 10,
      "register_type": "float32",
      "register_area": "holding",
      "scale": 1.0,
      "unit": "A",
      "description": "L3 current (via CT)"
    },
    {
      "name": "Active_Power",
      "offset": 12,
      "register_type": "float32",
      "register_area": "holding",
      "scale": 1.0,
      "unit": "W",
      "description": "3-phase active power"
    },
    {
      "name": "Reactive_Power",
      "offset": 14,
      "register_type": "float32",
      "register_area": "holding",
      "scale": 1.0,
      "unit": "var",
      "description": "3-phase reactive power"
    },
    {
      "name": "Apparent_Power",
      "offset": 16,
      "register_type": "float32",
      "register_area": "holding",
      "scale": 1.0,
      "unit": "VA",
      "description": "3-phase apparent power"
    },
    {
      "name": "Power_Factor",
      "offset": 18,
      "register_type": "float32",
      "register_area": "holding",
      "scale": 1.0,
      "description": "Overall power factor"
    },
    {
      "name": "Frequency",
      "offset": 20,
      "register_type": "float32",
      "register_area": "holding",
      "scale": 1.0,
      "unit": "Hz",
      "description": "Grid frequency"
    },
    {
      "name": "THD_Voltage",
      "offset": 22,
      "register_type": "float32",
      "register_area": "holding",
      "scale": 1.0,
      "unit": "%",
      "description": "Avg voltage THD"
    },
    {
      "name": "THD_Current",
      "offset": 24,
      "register_type": "float32",
      "register_area": "holding",
      "scale": 1.0,
      "unit": "%",
      "description": "Avg current THD"
    },
    {
      "name": "Temperature",
      "offset": 26,
      "register_type": "float32",
      "register_area": "holding",
      "scale": 1.0,
      "unit": "°C",
      "description": "Internal temperature"
    },
    {
      "name": "Active_Energy_Delivered",
      "offset": 3203,
      "register_type": "int64",
      "register_area": "holding",
      "scale": 0.001,
      "unit": "kWh",
      "description": "Active energy delivered (into load), register 3204"
    },
    {
      "name": "Active_Energy_Received",
      "offset": 3207,
      "register_type": "int64",
      "register_area": "holding",
      "scale": 0.001,
      "unit": "kWh",
      "description": "Active energy received (out of load), register 3208"
    },
    {
      "name": "Reactive_Energy_Delivered",
      "offset": 3219,
      "register_type": "int64",
      "register_area": "holding",
      "scale": 0.001,
      "unit": "kvarh",
      "description": "Reactive energy delivered, register 3220"
    },
    {
      "name": "Reactive_Energy_Received",
      "offset": 3223,
      "register_type": "int64",
      "register_area": "holding",
      "scale": 0.001,
      "unit": "kvarh",
      "description": "Reactive energy received, register 3224"
    }
  ]
}
