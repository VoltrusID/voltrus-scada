#!/usr/bin/env bash
# Pre-push gate: runs Rust checks only when the pushed commits touch Rust.
# Installed from scripts/install-git-hooks.sh — edit there, not in .git/hooks/.
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

pass=0
fail=0

run_check() {
  local name="$1"
  shift
  local slug=$(echo "$name" | tr ' ' '-')
  echo -e "${YELLOW}▶ $name${NC}"
  if "$@" > "/tmp/pre-push-${slug}.log" 2>&1; then
    echo -e "  ${GREEN}✓ $name passed${NC}"
    pass=$((pass + 1))
  else
    echo -e "  ${RED}✗ $name FAILED${NC}"
    tail -20 "/tmp/pre-push-${slug}.log"
    fail=$((fail + 1))
  fi
}

echo -e "${YELLOW}━━━ Pre-push checks ━━━${NC}"

# Detect Rust changes across ALL commits being pushed.
# Pre-push reads "<local ref> <local sha> <remote ref> <remote sha>" per line on stdin.
ZERO="0000000000000000000000000000000000000000"
EMPTY_TREE=$(git hash-object -t tree /dev/null 2>/dev/null || echo "4b825dc642cb6eb9a060e54bf8d69288fbee4904")
rust_changed=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # skip branch deletions
  [ "$local_sha" = "$ZERO" ] && continue
  # new branch → diff against empty tree; otherwise diff the pushed commit range
  if [ "$remote_sha" = "$ZERO" ]; then
    changed=$(git diff --name-only "$EMPTY_TREE" "$local_sha" 2>/dev/null)
  else
    changed=$(git diff --name-only "${remote_sha}..${local_sha}" 2>/dev/null)
  fi
  if printf '%s\n' "$changed" | grep -qE "(^|/)(Cargo\.toml|Cargo\.lock)$|\.rs$"; then
    rust_changed=1
  fi
done

if [ "$rust_changed" -eq 1 ]; then
  # cargo-audit has no project-local config; derive --ignore flags from
  # deny.toml so audit and deny share one source of truth (no drift).
  DENY_TOML="$(git rev-parse --show-toplevel 2>/dev/null)/deny.toml"
  audit_ignore_flags=""
  if [ -f "$DENY_TOML" ]; then
    audit_ignore_flags=$(grep -oE 'RUSTSEC-[0-9]{4}-[0-9]+' "$DENY_TOML" 2>/dev/null | sed 's/^/--ignore /' | tr '\n' ' ')
  fi

  run_check "cargo check" cargo check
  run_check "cargo test" cargo test
  # shellcheck disable=SC2086 — intentional word-split of --ignore flags
  run_check "cargo audit" cargo audit $audit_ignore_flags
  run_check "cargo deny" cargo deny check
else
  echo "  No Rust changes detected, skipping checks."
fi

echo ""
echo -e "${YELLOW}━━━ Results: ${GREEN}$pass passed${NC}${YELLOW}, ${RED}$fail failed${NC}${YELLOW} ━━━${NC}"

if [ "$fail" -gt 0 ]; then
  echo -e "${RED}Push blocked. Fix the failures above.${NC}"
  exit 1
fi

echo -e "${GREEN}All checks passed. Pushing...${NC}"
